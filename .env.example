# ==============================================================
# One-Stop Career & Education Advisor - Environment Configuration
# ==============================================================

# Neon Serverless PostgreSQL Database Connection String
# (Replace with your actual Neon PostgreSQL connection string)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis (Optional for caching & rate limiting)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Authentication Secrets (replace before deployment)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# API Gateway service targets
AUTH_SERVICE_URL=http://localhost:5001
CAREER_AI_SERVICE_URL=http://localhost:5002
LEARNING_SERVICE_URL=http://localhost:5003
OPPORTUNITY_SERVICE_URL=http://localhost:5004
RESUME_SERVICE_URL=http://localhost:5005
PROGRESS_SERVICE_URL=http://localhost:5006

# Microservice Ports
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
CAREER_AI_SERVICE_PORT=5002
LEARNING_SERVICE_PORT=5003
OPPORTUNITY_SERVICE_PORT=5004
RESUME_SERVICE_PORT=5005
PROGRESS_SERVICE_PORT=5006
FRONTEND_PORT=3000
